# .env.example — copy to .env for local development. Never commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Optional: email notifications (Gmail SMTP — free, no service needed) ──────
# Uses Python's built-in smtplib. No SendGrid or any third-party service.
#
# Setup (one-time, 2 minutes):
#   1. Enable 2-Step Verification at: myaccount.google.com/security
#   2. Generate an App Password at:   myaccount.google.com/apppasswords
#      → App: Mail  → Device: Other (name it "personal-ai")
#      → Copy the 16-character password (spaces don't matter)
#
GMAIL_USER=sudhirkumar02001@gmail.com
GMAIL_APP_PWD=xxxx xxxx xxxx xxxx
OWNER_EMAIL=sudhirkumar02001@gmail.com   # where to deliver notifications

# ── Optional: LangSmith observability ─────────────────────────────────────────
# Get key at: https://smith.langchain.com → Settings → API Keys
# Traces appear at: https://smith.langchain.com/projects/sowbhagya-personal-ai
#
# IMPORTANT: the SDK reads LANGCHAIN_API_KEY (not LANGSMITH_API_KEY).
# Set BOTH — app.py bridges them, but having both guarantees it works.
LANGSMITH_API_KEY=lsv2_pt_...
LANGCHAIN_API_KEY=lsv2_pt_...      # same value as LANGSMITH_API_KEY
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sowbhagya-personal-ai
