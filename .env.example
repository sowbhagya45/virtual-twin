# .env.example — copy to .env for local development. Never commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Optional: email notifications ─────────────────────────────────────────────
SENDGRID_API_KEY=SG....
OWNER_EMAIL=sudhirkumar02001@gmail.com

# SENDGRID_FROM_EMAIL — the "From:" address in emails sent by the app.
# MUST be a verified sender in your SendGrid account.
# Go to: app.sendgrid.com → Settings → Sender Authentication → Single Sender Verification
# If your OWNER_EMAIL is already verified there, you don't need to set this.
# If you get "403 Forbidden" errors, set this to your verified address.
SENDGRID_FROM_EMAIL=sudhirkumar02001@gmail.com

# ── Optional: LangSmith observability ─────────────────────────────────────────
# Get key at: https://smith.langchain.com → Settings → API Keys
# Traces appear at: https://smith.langchain.com/projects/sowbhagya-personal-ai
#
# IMPORTANT: the SDK reads LANGCHAIN_API_KEY (not LANGSMITH_API_KEY).
# Set BOTH — app.py bridges them, but having both guarantees it works.
LANGSMITH_API_KEY=lsv2_pt_...
LANGCHAIN_API_KEY=lsv2_pt_...      # same value as LANGSMITH_API_KEY
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sowbhagya-personal-ai
