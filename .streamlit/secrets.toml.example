# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .streamlit/secrets.toml for local dev, or paste into the Secrets
# panel on Streamlit Community Cloud (Settings → Secrets).
# This file is safe to commit. The real secrets.toml is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY = "AIza..."             # aistudio.google.com

# ── Optional: email notifications (Gmail SMTP — free, no service needed) ──────
# Uses Python's built-in smtplib — no SendGrid or any third-party service.
# Setup: myaccount.google.com/apppasswords → generate a 16-char App Password.
GMAIL_USER = "sudhirkumar02001@gmail.com"
GMAIL_APP_PWD = "xxxx xxxx xxxx xxxx"
OWNER_EMAIL = "sudhirkumar02001@gmail.com"

# ── Optional: LangSmith observability ─────────────────────────────────────────
# Every chat turn, tool call, RAG retrieval, and agent decision will appear
# as a fully traced run at https://smith.langchain.com/projects
#
# What you see in each trace:
#   • Top-level run:  "chat | <user question>"  (tagged with model name)
#   • Supervisor span: keyword routing decision OR llm-routing call
#   • Agent span:      rag-agent / scheduler-agent / notifier-agent / chitchat-agent
#   • Tool span:       retrieve_profile_info → chunks returned, relevance scores
#   • LLM span:        full input prompt + output tokens + latency
#   • Metadata:        thread_id, model, turn number, user_prompt (first 200 chars)
#
LANGSMITH_API_KEY = "lsv2_pt_..."      # smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_PROJECT = "sowbhagya-personal-ai"
