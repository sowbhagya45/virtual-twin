# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is git-ignored — never commit real secrets.
#
# On Streamlit Community Cloud: add these via the Secrets panel in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Required
GOOGLE_API_KEY = "AIza..."             # Google AI Studio: aistudio.google.com

# Optional — enables email notifications from the Notifier agent
SENDGRID_API_KEY = "SG...."            # SendGrid: app.sendgrid.com
OWNER_EMAIL = "sudhirkumar02001@gmail.com"

# Optional — enables LangSmith tracing
LANGSMITH_API_KEY = "ls__..."          # smith.langchain.com
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_PROJECT = "virtual-twin"
